# Required
ANTHROPIC_API_KEY=your-api-key-here  # Format: sk-ant-api03-...
PERPLEXITY_API_KEY=pplx-abcde
STRIPE_SECRET_KEY=sk_test_...        # Your Stripe secret key
STRIPE_WEBHOOK_SECRET=whsec_...       # Your Stripe webhook secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_... # Your Stripe publishable key

# Optional - defaults shown
MODEL=claude-3-7-sonnet-20250219  # Recommended models: claude-3-7-sonnet-20250219, claude-3-opus-20240229
MAX_TOKENS=4000                   # Maximum tokens for model responses
TEMPERATURE=0.7                   # Temperature for model responses (0.0-1.0)
DEBUG=false                       # Enable debug logging (true/false)
LOG_LEVEL=info                    # Log level (debug, info, warn, error)
DEFAULT_SUBTASKS=3                # Default number of subtasks when expanding
DEFAULT_PRIORITY=medium           # Default priority for generated tasks (high, medium, low)
PROJECT_NAME=nextjs-template      # Project name for tasks.json metadata
PROJECT_VERSION=1.0.0             # Project version for tasks.json metadata

# Stripe Product/Price IDs
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...  # Your Stripe price ID for the Pro plan

# Zoho SalesIQ OAuth (Server-based app — bulk article automation)
# Register redirect: https://www.adwiiseagent.ai/oauth/zoho/callback
# (and http://localhost:3000/oauth/zoho/callback for local dev)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_SALESIQ_SCREEN_NAME=giventainc
# Production callback (local dev auto-uses http://localhost:3000/oauth/zoho/callback)
ZOHO_OAUTH_REDIRECT_URI=https://www.adwiiseagent.ai/oauth/zoho/callback
# ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
# ZOHO_SALESIQ_API_BASE=https://salesiq.zoho.com
# ZOHO_OAUTH_SCOPES=SalesIQ.articles.READ,SalesIQ.articles.DELETE
# ZOHO_OAUTH_SETUP_SECRET=optional-secret-for-/oauth/zoho/start
# Admin Help Chat (Bedrock — same model family as retail AI engine)
# On by default. Set BEDROCK_ENABLED=false to force knowledge-pack stub answers only.
BEDROCK_ENABLED=true
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
# Optional aliases if primary names collide with other tooling:
# ADMIN_HELP_BEDROCK_ENABLED=true
# ADMIN_HELP_BEDROCK_REGION=us-east-1
# ADMIN_HELP_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
